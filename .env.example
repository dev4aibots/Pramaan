# Postgres with pgvector (Neon / Supabase / local docker pgvector/pgvector:pg16)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# 32+ random chars: openssl rand -base64 32
AUTH_SECRET=change-me
# 32 bytes base64 for AES-256-GCM key encryption: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# Optional: Google Drive connector (OAuth Web client ID, add your domain to Authorized JS origins)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
